[Unit]
Description=Volvo HUDIY dashboard metrics service
After=default.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/share/volvo-hudiy-dashboard/metrics_server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=default.target
